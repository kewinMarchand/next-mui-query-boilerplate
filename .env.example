# URL publique du site (canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suivi des erreurs GlitchTip (DSN au format Sentry). Vides : aucun SDK chargé, aucune requête
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
# Défaut : development en dev, production sinon
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=

# Schéma OpenAPI de l'API consommée, pour `make api-types`
API_SCHEMA_URL=
