# URL publique du site (canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suivi des erreurs GlitchTip (DSN au format Sentry). Vides : aucun SDK chargé, aucune requête
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
# Défaut : development en dev, production sinon
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=

# Mesure d'audience Matomo sans cookie (URL de l'instance, barre finale comprise). Vides : aucun script, aucune requête
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# API consommée : http://localhost:8090 (API Platform, défaut) ou http://localhost:8091 (Hono), même contrat
API_URL=http://localhost:8090

# Schéma OpenAPI de l'API consommée, pour `make api-types`
API_SCHEMA_URL=http://localhost:8090/api/docs.jsonopenapi
