{
  "breakpoints": {
    "values": {
      "xs": 0,
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    }
  },
  "palette": {
    "primary": {
      "main": "#1d4ed8",
      "dark": "#1e3a8a",
      "contrastText": "#ffffff"
    },
    "secondary": {
      "main": "#7c3aed",
      "dark": "#5729a6",
      "contrastText": "#ffffff"
    },
    "error": {
      "main": "#b91c1c"
    },
    "warning": {
      "main": "#92400e"
    },
    "info": {
      "main": "#1e40af"
    },
    "success": {
      "main": "#166534"
    },
    "text": {
      "primary": "#111827",
      "secondary": "#4b5563"
    },
    "background": {
      "default": "#ffffff",
      "paper": "#ffffff"
    },
    "divider": "#e5e7eb"
  },
  "typography": {
    "fontFamily": "'Inter Variable', 'Inter Fallback', system-ui, sans-serif",
    "fontSize": 16,
    "htmlFontSize": 16,
    "h1": {
      "fontSize": "var(--bui-font-size-h1, 40px)",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "h2": {
      "fontSize": "var(--bui-font-size-h2, 28px)",
      "fontWeight": 600
    },
    "h3": {
      "fontSize": "var(--bui-font-size-h3, 22px)",
      "fontWeight": 600
    },
    "h4": {
      "fontSize": "var(--bui-font-size-h4, 18px)",
      "fontWeight": 600
    },
    "h5": {
      "fontSize": "var(--bui-font-size-title, 20px)",
      "fontWeight": 600
    },
    "subtitle1": {
      "fontSize": "var(--bui-font-size-lead, 18px)"
    },
    "caption": {
      "fontSize": "var(--bui-font-size-caption, 12px)"
    },
    "body1": {
      "fontSize": "var(--bui-font-size-body, 16px)"
    },
    "body2": {
      "fontSize": "var(--bui-font-size-body-sm, 14px)"
    },
    "overline": {
      "fontSize": "var(--bui-font-size-overline, 14px)"
    }
  },
  "shape": {
    "borderRadius": 8
  }
}
